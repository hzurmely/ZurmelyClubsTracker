# Copie este arquivo para .env.local e ajuste

# Clube que aparece em destaque na home ("Meu Clube").
# Pegue o ID buscando o clube no proprio site: ele aparece na URL /clube/<plataforma>/<id>
NEXT_PUBLIC_MY_CLUB_ID=
NEXT_PUBLIC_MY_CLUB_PLATFORM=common-gen5

# Nome e slogan do site
NEXT_PUBLIC_SITE_NAME=ZurmelyClubsTracker
NEXT_PUBLIC_SITE_TAGLINE=Analytics de Pro Clubs para EA FC 26

# Modo demonstracao: 1 usa dados falsos de exemplo (util quando a API da EA esta fora
# do ar ou quando voce esta sem internet). O site mostra um aviso amarelo quando ligado.
EA_DEMO=0
