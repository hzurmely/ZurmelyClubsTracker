# Copy this file to .env.local and adjust

# Pins one club on the home page for everyone who opens the site.
# Not needed for normal use: just open the club page and click
# "Set as my club", and the choice is stored in the browser of whoever clicked.
# Get the ID by searching for the club on the site itself: it shows up in the
# URL /clube/<platform>/<id>
NEXT_PUBLIC_MY_CLUB_ID=
NEXT_PUBLIC_MY_CLUB_PLATFORM=common-gen5

# Site name and tagline. Leave the tagline empty and it follows the language
# the visitor is reading in.
NEXT_PUBLIC_SITE_NAME=ZurmelyClubsTracker
NEXT_PUBLIC_SITE_TAGLINE=

# Demo mode: 1 uses the fake sample data (handy when the EA API is down or you
# are offline). The site shows a yellow notice while it is on. Be careful not to
# build the desktop program with this switched on.
EA_DEMO=0

# Detour through the public reader r.jina.ai when EA blocks the server IP.
# On by default. Set 0 to turn it off and only talk to EA directly.
EA_LEITOR=1
